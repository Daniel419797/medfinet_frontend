{
  "name": "medfi-health-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source browser application for the Medfinet child-health continuity platform.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Daniel419797/medfinet_frontend.git"
  },
  "bugs": {
    "url": "https://github.com/Daniel419797/medfinet_frontend/issues"
  },
  "homepage": "https://github.com/Daniel419797/medfinet_frontend#readme",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.pr.json",
    "typecheck:all": "tsc --noEmit -p tsconfig.app.json",
    "build": "npm run typecheck && npm run build:pwa",
    "build:pwa": "vite build && node scripts/finalize-pwa.mjs",
    "lint": "eslint .",
    "lint:pr": "eslint src/main.tsx src/App.tsx src/NfcApp.tsx src/pages/landing/LandingPage.tsx src/pages/nfc src/pages/offline src/components/auth src/components/offline src/components/pwa src/contexts/UserContext.tsx src/hooks/useOnlineStatus.ts src/services/medfinetAuthApi.ts src/services/medfinetApiClient.ts src/services/medfinetNfcApi.ts src/services/nfcDeviceKeyStore.ts src/services/nfcOfflineStore.ts src/services/offlineQueueStore.ts src/services/offlineSessionStore.ts src/services/offlineSyncService.ts src/services/pwaBackgroundSync.ts src/services/secureOfflineStore.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint:pr && npm test && npm run build:pwa",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.8",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "2.111.0",
    "localforage": "^1.10.0",
    "lucide-react": "^0.525.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@headlessui/react": "^2.2.9",
    "@json-rpc-tools/utils": "^1.7.6",
    "@perawallet/connect": "^1.4.2",
    "@solana/wallet-adapter-base": "^0.9.23",
    "@solana/wallet-adapter-phantom": "^0.9.24",
    "@solana/wallet-adapter-react": "^0.15.35",
    "@solana/wallet-adapter-react-ui": "^0.9.35",
    "@solana/wallet-adapter-wallets": "^0.19.32",
    "@solana/web3.js": "^1.95.2",
    "@stripe/react-stripe-js": "^3.9.2",
    "@stripe/stripe-js": "^7.9.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "algosdk": "^3.3.1",
    "autoprefixer": "^10.4.18",
    "axios": "^1.10.0",
    "chart.js": "^4.4.1",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "ethers": "^6.13.2",
    "globals": "^15.9.0",
    "jsdom": "^29.1.1",
    "jsqr": "^1.4.0",
    "leaflet": "^1.9.4",
    "lottie-web": "^5.13.0",
    "mapbox-gl": "^3.1.2",
    "pako": "^2.1.0",
    "postcss": "^8.4.35",
    "qrcode.react": "^3.1.0",
    "react-leaflet": "^4.2.1",
    "react-map-gl": "^7.1.7",
    "react-qr-scanner": "^1.0.0-alpha.11",
    "swr": "^2.2.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "vitest": "^4.1.10"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
